# Скопируй этот файл в `.env.local` и заполни своими значениями.
# `.env.local` в .gitignore — реальные ключи в репозиторий не попадают.

# --- CoinGecko (крипта: рынок, монеты, графики) ---
# Demo-ключ (бесплатный, ~10k запросов/мес): https://www.coingecko.com/en/api
# СЕРВЕРНЫЙ ключ — без NEXT_PUBLIC, в браузер не утекает (запросы идут через
# /api/crypto/* прокси). Ключ опционален: без него публичный CoinGecko тоже
# работает, но с более низким рейт-лимитом.
COINGECKO_KEY="your-coingecko-demo-key"

# --- MOEX (Московская биржа, публичный ISS API, ключ не нужен) ---
NEXT_PUBLIC_MOEX_API="https://iss.moex.com/"

# --- Tinkoff / Т-Банк Invest (через прокси-сервис) ---
# Базовый URL прокси, который проксирует запросы к invest-public-api.tinkoff.ru.
# Пер-юзер токен НЕ хранится здесь — пользователь вводит его в UI, он лежит в Firestore.
NEXT_PUBLIC_TINKOFF_API="https://your-tinkoff-proxy.example.app"

# --- Trezor / крипта: Blockbook-прокси для BTC (по xpub) и ETH (по адресу) ---
# Публичный Blockbook Trezor (btc1/eth1.trezor.io) за Cloudflare режет облачные IP
# (на Vercel → 502). На проде укажи провайдера с api-key, напр. NOWNodes.
# Локально можно оставить пустым — сработает дефолт на trezor.io.
# Внимание: у NOWNodes хосты несимметричны — BTC=btcbook, ETH=eth-blockbook.
BTC_BLOCKBOOK="https://btcbook.nownodes.io"
ETH_BLOCKBOOK="https://eth-blockbook.nownodes.io"
BLOCKBOOK_API_KEY="your-nownodes-api-key"
# Публичный ETH-RPC для дочитывания стейкинга Everstake (eth_call). Дефолт рабочий,
# менять не обязательно.
ETH_RPC="https://ethereum-rpc.publicnode.com"

# --- Bybit (крипта на бирже: балансы аккаунта в портфель) ---
# API-ключ создаётся в кабинете Bybit как READ-ONLY (права только на чтение
# Account/Wallet, БЕЗ Trade и Withdraw). Secret — СЕРВЕРНЫЙ, без NEXT_PUBLIC:
# запросы идут через /api/bybit прокси, в браузер secret не уходит.
# Для начала НЕ включай IP-whitelist (у Vercel динамические IP — иначе запросы
# упадут, как Blockbook 502). BYBIT_API_BASE менять не нужно (тестнет — api-testnet.bybit.com).
BYBIT_API_KEY="your-bybit-read-only-key"
BYBIT_API_SECRET="your-bybit-read-only-secret"
# BYBIT_API_BASE="https://api.bybit.com"

# --- Firebase (auth + Firestore) ---
# Значения из настроек Web App в консоли Firebase. Эти ключи не секретные
# (Firebase защищает данные через Security Rules), но всё равно храним в env.
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
