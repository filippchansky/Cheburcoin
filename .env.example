# Скопируй этот файл в `.env.local` и заполни своими значениями.
# `.env.local` в .gitignore — реальные ключи в репозиторий не попадают.

# --- CoinStats (крипта: монеты, графики, новости) ---
# Ключ API: https://openapi.coinstats.app/
NEXT_PUBLIC_COIN="your-coinstats-api-key"
NEXT_PUBLIC_COIN_API="https://openapiv1.coinstats.app/"

# --- MOEX (Московская биржа, публичный ISS API, ключ не нужен) ---
NEXT_PUBLIC_MOEX_API="https://iss.moex.com/"

# --- Tinkoff / Т-Банк Invest (через прокси-сервис) ---
# Базовый URL прокси, который проксирует запросы к invest-public-api.tinkoff.ru.
# Пер-юзер токен НЕ хранится здесь — пользователь вводит его в UI, он лежит в Firestore.
NEXT_PUBLIC_TINKOFF_API="https://your-tinkoff-proxy.example.app"

# --- Trezor / крипта: Blockbook-прокси для BTC (по xpub) и ETH (по адресу) ---
# Публичный Blockbook Trezor (btc1/eth1.trezor.io) за Cloudflare режет облачные IP
# (на Vercel → 502). На проде укажи провайдера с api-key, напр. NOWNodes.
# Локально можно оставить пустым — сработает дефолт на trezor.io.
BTC_BLOCKBOOK="https://btcbook.nownodes.io"
ETH_BLOCKBOOK="https://ethbook.nownodes.io"
BLOCKBOOK_API_KEY="your-nownodes-api-key"

# --- Firebase (auth + Firestore) ---
# Значения из настроек Web App в консоли Firebase. Эти ключи не секретные
# (Firebase защищает данные через Security Rules), но всё равно храним в env.
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGINGSENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
