# Caddy — обратный прокси с автоматическим HTTPS.
# Кладётся на VPS в /etc/caddy/Caddyfile.  Перечитать: `sudo systemctl reload caddy`.
#
# Как только домен cheburcoin.ru резолвится на IP этого сервера и открыты порты
# 80/443, Caddy сам получит сертификат Let's Encrypt и будет его продлевать.

cheburcoin.ru {
    encode gzip zstd
    reverse_proxy 127.0.0.1:3000
}

# --- ВРЕМЕННО, до переключения DNS ---
# Пока cheburcoin.ru ещё смотрит на Vercel, домен-блок выше сертификат не получит.
# Чтобы проверить приложение по IP до переезда DNS, можно временно РАСКОММЕНТИРОВАТЬ
# блок ниже (HTTP без сертификата, по IP) и закомментировать блок домена выше:
#
# http://195.133.61.198 {
#     encode gzip zstd
#     reverse_proxy 127.0.0.1:3000
# }
