# РАНТАЙМ-секреты для VPS. На сервере копируется в /home/deploy/cheburcoin/shared/.env
# (chmod 600, владелец deploy). В git попадает ТОЛЬКО этот пример, реальный .env — никогда.
#
# Важно: сюда идут ТОЛЬКО серверные переменные (без NEXT_PUBLIC).
# NEXT_PUBLIC_* запекаются в сборку в GitHub Actions и здесь не нужны.
# PORT/HOSTNAME/NODE_ENV задаются в systemd-юните, дублировать не надо.

# --- CoinGecko (крипта) — опционально; без ключа работает публичный лимит ---
COINGECKO_KEY=

# --- Bybit (READ-ONLY ключ: права только на чтение, без Trade/Withdraw) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_API_BASE=https://api.bybit.com
# BYBIT_RECV_WINDOW=5000

# --- Trezor Blockbook (BTC по xpub, ETH по адресу) ---
# С московского VPS (VDSina) публичный Trezor Blockbook доступен (Cloudflare-блок
# Trezor бьёт по облачным диапазонам AWS/Vercel, не по нам) — ключ НЕ нужен.
# Если Trezor однажды начнёт резать этот IP → переключить на провайдера с api-key,
# напр. NOWNodes (BTC=btcbook.nownodes.io, ETH=eth-blockbook.nownodes.io) + BLOCKBOOK_API_KEY.
BTC_BLOCKBOOK=https://btc1.trezor.io
ETH_BLOCKBOOK=https://eth1.trezor.io
BLOCKBOOK_API_KEY=
# Публичный ETH-RPC для дочитывания стейкинга Everstake. Дефолт рабочий.
ETH_RPC=https://ethereum-rpc.publicnode.com

# --- Solana: серверный RPC для стейкинга ---
SOLANA_RPC_SERVER=

# --- CryptoPanic: новости по монете на детальной странице ---
CRYPTOPANIC_KEY=
